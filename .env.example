# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Generation: primary path (Gemini free tier) ---
# Key from https://aistudio.google.com/apikey  -- free tier, no billing required.
# Free tier is FLASH-ONLY since May 2026; every *-pro id will 404/quota-fail.
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
# Degrade target when GEMINI_MODEL hits its rate limit, before falling to Ollama.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Generation: fallback path (local Ollama) ---
OLLAMA_HOST=http://localhost:11434
# qwen3.5:4b (3.4GB, 256K ctx) replaced gemma3:4b - see CLAUDE.md Known Gotchas.
# Drop to qwen3.5:2b (2.7GB) if 4b is too slow on the 4GB card.
OLLAMA_MODEL=qwen3.5:4b

# --- Embeddings ---
# Section 2: InLegal-Sbert specifically. NOT law-ai/InLegalBERT (that is the base
# MLM model - no trained pooling layer, produces poor similarity embeddings
# WITHOUT raising an error). NOT a generic sentence-transformer either.
EMBEDDING_MODEL=bhavyagiri/InLegal-Sbert
EMBEDDING_DIM=768
# Challenger, compared at the Phase 2 gate by scripts/embedding_bakeoff.py.
# Whichever wins on the 15 test cases is locked BEFORE mass ingestion.
EMBEDDING_CHALLENGER=BAAI/bge-m3
EMBEDDING_CHALLENGER_DIM=1024
EMBEDDING_DEVICE=cuda

# --- Storage paths (relative to project root, D:\nayasetu) ---
CHROMA_DIR=./chroma_db
OUTCOMES_DB=./outcomes.db
CITATION_GRAPH=./citation_graph.gpickle

# --- Stage 0: Offence-Date Router (Section 2 - load-bearing, do not change) ---
BNS_TRANSITION_DATE=2024-07-01
